# Get free sandbox keys at https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret
PLAID_ENV=sandbox

# Required for npm run dev, npm start, and a server or Docker container.
# Use a long random string you keep somewhere safe. Anchored encrypts the
# SQLite file with it. If this is missing, still the placeholder, or different
# from the value used to create the database, Anchored will not open the file.
# The Windows app does not read this. It stores its own key in the OS credential store.
# If you lose the key, the database cannot be opened.
DATABASE_KEY=your_database_key
