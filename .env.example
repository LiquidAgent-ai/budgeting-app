# Get free sandbox keys at https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret
PLAID_ENV=sandbox

# Required. Use a long random string you keep somewhere safe. Anchored encrypts
# the SQLite file with it. If this is missing, still the placeholder, or different
# from the value used to create the database, Anchored will not open the file.
# If you lose the key, the database cannot be opened.
DATABASE_KEY=your_database_key

# Optional. Public https address when the container sits behind Nginx Proxy Manager.
# APP_URL=https://budget.example.com

# Leave unset for local runs. The database file stays at data/anchored.db.
# The container sets this to /data/anchored.db.
# DATABASE_PATH=/data/anchored.db
