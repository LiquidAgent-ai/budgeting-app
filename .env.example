# Free Teller developer keys: https://teller.io/
# Sandbox needs only the application id. Development/production also need a
# client certificate from the Teller dashboard (paths or PEM env vars).
TELLER_APPLICATION_ID=your_application_id
TELLER_ENV=sandbox
# TELLER_CERT_PATH=/path/to/certificate.pem
# TELLER_KEY_PATH=/path/to/private_key.pem
# TELLER_CERT_PEM=
# TELLER_KEY_PEM=

# Optional. Get sandbox keys at https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret
PLAID_ENV=sandbox

# Automatic read-only bank sync (Plaid items + Teller enrollments) in the Rust
# process — same on Windows desktop and in the container. Default: on, every 24h.
# Set ANCHORED_SYNC_ENABLED=0 (or false/off/no) to disable. Interval 0 also disables.
# ANCHORED_SYNC_ENABLED=1
# ANCHORED_SYNC_INTERVAL_HOURS=24

# Required. Use a long random string you keep somewhere safe. Anchored encrypts
# the SQLite file with it. If this is missing, still the placeholder, or different
# from the value used to create the database, Anchored will not open the file.
# If you lose the key, the database cannot be opened.
DATABASE_KEY=your_database_key

# Optional. Public https address when the container sits behind Nginx Proxy Manager.
# APP_URL=https://budget.example.com

# Leave unset for local runs. The database file stays at data/anchored.db.
# The container sets this to /data/anchored.db.
# DATABASE_PATH=/data/anchored.db
